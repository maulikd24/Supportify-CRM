// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Supportify platform: multi-tenant organizations
//
// Every User and every piece of tenant data belongs to exactly one
// Organization. This is the paying-customer boundary for the whole app —
// both the CRM product below and the QA product (see qa.prisma-equivalent
// section further down) are scoped by organizationId.
// ---------------------------------------------------------------------------

enum OrgRole {
  OWNER
  ADMIN
  MEMBER
  // QA Sentinel agent-portal login: sees only their own reviews and coaching,
  // never CRM or QA admin pages, and never takes a CRM seat.
  AGENT
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
}

// The two independently-purchasable products on the platform. Each
// (Organization, Product) pair has its own ProductSubscription — an org can
// be trialing/paying for one without the other.
enum Product {
  QA_SENTINEL
  CRM
  // AI analysis of every customer conversation across sources (src/lib/cx).
  CX_INTELLIGENCE
}

model Organization {
  id                   String  @id @default(cuid())
  name                 String
  slug                 String  @unique
  // Last client number handed out in this org (client codes CL-00001, CL-00002, …).
  // Incremented atomically by generateClientCode, so concurrent creates never collide.
  clientCodeSeq        Int      @default(0)
  // AI message drafting in the Inbox (src/lib/drafting). Admins can switch it off and steer
  // the tone; drafts are only ever suggestions an RM edits and sends.
  aiDraftingEnabled    Boolean @default(true)
  aiDraftTone          String? // e.g. "Warm and concise, use the client's first name"
  aiDraftAvoid         String? // phrases or topics drafts must avoid, one per line
  stripeCustomerId     String? @unique // one Stripe Customer per org; subscriptions live per-product below
  // Set once an admin starts SSO setup (see src/lib/sso/workos.ts). The actual
  // SAML/OIDC connection + domain(s) are configured by the customer's own IT
  // admin in WorkOS's hosted Admin Portal — we never touch SAML XML directly.
  workosOrganizationId String? @unique
  // Email domain (e.g. "acme.com") routed to this org's SSO connection at
  // login. Set by the org admin in Settings > SSO — WorkOS itself only knows
  // about domains once the customer's IT admin configures them on the
  // connection, which happens later and separately in the Admin Portal, so we
  // keep our own copy to route the initial "sign in with SSO" redirect.
  ssoDomain            String? @unique

  // Security policies (Scale/Enterprise). See src/lib/security/policy.ts.
  require2fa        Boolean   @default(false) // members must set up 2FA before using the app
  requireSso        Boolean   @default(false) // members (not the owner) must sign in with SSO
  sessionMaxHours   Int? // sign members out this long after they signed in; null = default (30 days)
  sessionsRevokedAt DateTime? // "sign out all devices": sessions started before this are ended
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  members                User[]
  subscriptions          ProductSubscription[]
  clients                Client[]
  stages                 Stage[]
  customFieldDefinitions CustomFieldDefinition[]
  tasks                  Task[]
  activities             Activity[]
  journeys               Journey[]
  journeyRuns            JourneyRun[]
  documents              Document[]
  exceptions             Exception[]
  messages               Message[]
  messageTemplates       MessageTemplate[]
  notifications          Notification[]
  auditLogs              AuditLog[]
  integrationConfigs     IntegrationConfig[]

  helpdeskConnection HelpdeskConnection?
  sopDocuments       SopDocument[]
  ticketReviews      TicketReview[]
  dsatAnalyses       DsatAnalysis[]
  autoReviewConfig   AutoReviewConfig?
  scorecards         Scorecard[]
  autoReviewJobs     AutoReviewJob[]
  coachingSessions   CoachingSession[]
  reviewDisputes     ReviewDispute[]

  aiDrafts            AiDraft[]
  apiKeys             ApiKey[]
  webhookEndpoints    WebhookEndpoint[]
  alertChannels       AlertChannel[]
  requesterLinks      RequesterLink[]

  cxSources        CxSource[]
  cxConversations  Conversation[]
  cxTopics         Topic[]
  cxTaxonomies     TaxonomyVersion[]
  cxTeams          Team[]
  cxAgentMappings  AgentTeamMapping[]
  cxCostSettings   CxCostSettings?
  cxClassifyBatches CxClassifyBatch[]
  cxMetricBuckets  CxMetricBucket[]
  cxTopicIssues    TopicIssue[]
  calibrationSessions CalibrationSession[]
}

// ---------------------------------------------------------------------------
// Public API access & outgoing webhooks
// ---------------------------------------------------------------------------

model ApiKey {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  // First few characters of the raw key, shown in the UI so a customer can
  // tell keys apart without ever seeing the full secret again after creation.
  keyPrefix      String
  // SHA-256 of the raw key (not bcrypt) — API keys are high-entropy random
  // tokens, not passwords, so a fast deterministic hash is safe and lets a
  // request authenticate with a single indexed lookup instead of scanning
  // every key with a slow per-row bcrypt.compare.
  hashedKey      String       @unique
  createdById    String
  createdBy      User         @relation(fields: [createdById], references: [id], onDelete: NoAction)
  lastUsedAt     DateTime?
  revokedAt      DateTime?
  createdAt      DateTime     @default(now())

  @@index([organizationId])
}

model WebhookEndpoint {
  id              String       @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  url             String
  // AES-256-GCM encrypted (see src/lib/security/crypto.ts) — unlike the API
  // key hash above, this must be recoverable in plaintext to HMAC-sign each
  // outgoing delivery.
  encryptedSecret String
  events          Json // string[] of subscribed event types, e.g. ["client.created"]
  isActive        Boolean      @default(true)
  createdAt       DateTime     @default(now())

  deliveries WebhookDelivery[]

  @@index([organizationId])
}

model WebhookDelivery {
  id                String          @id @default(cuid())
  webhookEndpointId String
  webhookEndpoint   WebhookEndpoint @relation(fields: [webhookEndpointId], references: [id], onDelete: Cascade)
  event             String
  statusCode        Int?
  success           Boolean
  error             String?
  createdAt         DateTime        @default(now())

  @@index([webhookEndpointId, createdAt])
}

// One AI-drafted reply (src/lib/drafting): what the model produced and what it cost, kept for
// quality review and per-org cost tracking. The RM always edits and sends it themselves.
model AiDraft {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  clientId       String
  mode           String // "text" (free reply) | "template" (approved template + variables)
  channel        String // "whatsapp" | "sms"
  model          String
  promptVersion  String
  draft          Json // { text } or { templateId, variables }
  inputTokens    Int
  outputTokens   Int
  costUsd        Float
  createdAt      DateTime     @default(now())

  @@index([organizationId, createdAt])
}

// A Slack or Microsoft Teams channel that team alerts (SLA breaches, overdue tasks, …) are
// posted to — see src/lib/alerts. Slack channels come from the "Add to Slack" OAuth flow
// (incoming-webhook scope only); Teams channels from a workflow webhook URL an admin pastes.
model AlertChannel {
  id                  String       @id @default(cuid())
  organizationId      String
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  kind                String // "slack" | "teams"
  name                String // shown in settings, e.g. "#sla-alerts · Acme" or the admin's label
  // AES-256-GCM encrypted (see src/lib/security/crypto.ts): the webhook URL is itself the credential.
  encryptedUrl        String
  alertTypes          Json // string[] of ALERT_TYPES routed here (src/lib/alerts/types.ts)
  isActive            Boolean      @default(true)
  // Deliveries that failed in a row; at 3 the channel is switched off and admins are told in-app.
  consecutiveFailures Int          @default(0)
  lastError           String?
  createdById         String?
  createdAt           DateTime     @default(now())

  deliveries AlertDelivery[]

  @@index([organizationId])
}

model AlertDelivery {
  id             String       @id @default(cuid())
  alertChannelId String
  alertChannel   AlertChannel @relation(fields: [alertChannelId], references: [id], onDelete: Cascade)
  alertType      String
  alertCount     Int          @default(1) // >1 when several alerts went out as one digest message
  success        Boolean
  attempts       Int
  statusCode     Int?
  error          String?
  createdAt      DateTime     @default(now())

  @@index([alertChannelId, createdAt])
}

model ProductSubscription {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product        Product

  planId               String? // "starter" | "growth" | "enterprise" — see src/lib/billing/plans.ts
  status               SubscriptionStatus @default(TRIALING)
  stripeSubscriptionId String?            @unique
  stripePriceId        String?

  seats                 Int? // CRM plans: purchased seat count
  reviewQuota           Int? // QA Sentinel plans: reviews allowed per billing period
  reviewsUsedThisPeriod Int  @default(0)
  aiDraftsUsedThisPeriod Int @default(0) // CRM: AI reply drafts used this period (quota: billing/plans.ts)

  currentPeriodEnd DateTime?
  trialEndsAt      DateTime?
  pastDueSince     DateTime? // first failed payment; access continues for PAST_DUE_GRACE_DAYS

  // QA Sentinel usage-based overages (opt-in by an org admin, capped per period).
  allowOverage             Boolean @default(false)
  overageCap               Int? // max overage reviews per billing period; null = no cap
  overageReviewsThisPeriod Int     @default(0)

  // CX Intelligence: conversations analysed per period (quota from billing/plans.ts CX_PLANS).
  analysisQuota             Int? // null = unlimited (enterprise)
  analysesUsedThisPeriod    Int  @default(0)
  overageAnalysesThisPeriod Int  @default(0)

  // Annual plans bill yearly but quotas are monthly: usage resets every month
  // from usagePeriodStart (see resetMonthlyUsageForAnnualPlans).
  billingInterval  String? // "month" | "year"
  usagePeriodStart DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([organizationId, product])
}

enum VerificationTokenPurpose {
  EMAIL_VERIFY
  PASSWORD_RESET
  // Short-lived, single-use bridge between the WorkOS SSO callback (which runs
  // in a plain Route Handler) and NextAuth's Credentials provider (which is
  // what actually establishes the session) — see src/lib/auth/config.ts.
  SSO_LOGIN
}

model VerificationToken {
  id        String                   @id @default(cuid())
  token     String                   @unique
  userId    String
  user      User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose   VerificationTokenPurpose
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime                 @default(now())

  @@index([userId, purpose])
}

// ---------------------------------------------------------------------------
// Identity & RBAC
// ---------------------------------------------------------------------------

enum Role {
  ADMIN
  MANAGER
  RM
  DEALER
}

model User {
  id              String    @id @default(cuid())
  name            String
  email           String    @unique
  passwordHash    String
  emailVerifiedAt DateTime?
  // Supportify staff only — never settable via any customer-reachable UI.
  // Grants access to /admin (cross-org aggregate metrics + subscription
  // adjustments), never direct browsing of another org's customer data.
  isPlatformAdmin Boolean   @default(false)
  role            Role      @default(RM)
  isActive        Boolean   @default(true)

  // Login brute-force lockout — incremented on each failed password/2FA
  // attempt in authorize() (src/lib/auth/config.ts), reset on success.
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  // TOTP two-factor auth. Secret is AES-256-GCM encrypted at rest (see
  // src/lib/security/crypto.ts) — never stored or logged in plaintext.
  // twoFactorSecret is set as soon as setup starts but twoFactorEnabled only
  // flips to true once the user proves possession with a valid code, so an
  // abandoned setup never silently locks anyone out.
  twoFactorSecret        String?
  twoFactorEnabled       Boolean  @default(false)
  twoFactorRecoveryCodes Json? // array of bcrypt hashes; each is deleted on use
  capacity               Int? // max active clients this RM should carry (reporting only, not enforced)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  // Supportify tenancy: every user belongs to exactly one Organization.
  // `role` above is the existing CRM-specific hierarchy (ADMIN/MANAGER/RM/
  // DEALER) and stays as a finer-grained layer *within* an org; `orgRole` is
  // the org-membership level (billing/ownership/invite management).
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  orgRole        OrgRole      @default(MEMBER)
  // AGENT only: the email their helpdesk (Zendesk) reviews are filed under,
  // when it differs from their login email.
  helpdeskEmail  String?

  managerId String?
  manager   User?   @relation("TeamHierarchy", fields: [managerId], references: [id])
  reports   User[]  @relation("TeamHierarchy")

  assignedClients    Client[]            @relation("AssignedRM")
  tasks              Task[]
  activities         Activity[]
  notifications      Notification[]
  createdJourneys    Journey[]
  stageChanges       StageHistory[]
  auditLogs          AuditLog[]
  verificationTokens VerificationToken[]
  apiKeys            ApiKey[]

  createdCalibrationSessions CalibrationSession[]
  calibrationEntries         CalibrationEntry[]
  coachingSessions           CoachingSession[]    @relation("CoachingCoach")
  raisedDisputes             ReviewDispute[]      @relation("DisputeRaisedBy")
  resolvedDisputes           ReviewDispute[]      @relation("DisputeResolvedBy")
  sessionsRevokedAt          DateTime? // admin "sign out this user": sessions started before this are ended

  @@index([organizationId])
}

// ---------------------------------------------------------------------------
// Client Onboarding: the core domain
// ---------------------------------------------------------------------------

enum ClientStatus {
  ACTIVE
  ON_HOLD
  COMPLETED
  NOT_PROCEEDING
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

model Client {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clientCode     String // generated "CL-00001", unique per organization (see @@unique below)
  name           String
  mobile         String
  email          String?
  city           String?
  state          String?
  clientType     String?
  leadSource     String?
  referralSource String?
  notes          String?
  // Generic deal value, replacing the old finance-vertical "expectedInvestment" —
  // works for any sales pipeline (deal size, contract value, MRR, etc).
  dealValue      Decimal?
  // Org-defined extra fields (see CustomFieldDefinition), keyed by that model's `key`.
  customFields   Json?
  priority       Priority     @default(MEDIUM)
  status         ClientStatus @default(ACTIVE)
  currentStageId String
  currentStage   Stage        @relation(fields: [currentStageId], references: [id], onDelete: NoAction)
  stageEnteredAt DateTime     @default(now())
  // When the stage-SLA sweep last alerted about this client. Older than
  // stageEnteredAt (or null) means this stay in the stage hasn't been alerted
  // yet — see src/lib/sla/check-stage-sla.ts.
  slaBreachNotifiedAt  DateTime?
  // When the disengagement sweep last alerted. Any Activity/Message after it
  // re-arms the alert — see src/lib/copilot/check-disengagement.ts.
  disengagedNotifiedAt DateTime?
  // Set when a support-quality drop was alerted; cleared when quality recovers, which
  // re-arms the alert — see src/lib/support-health/health.ts.
  supportRiskNotifiedAt DateTime?
  assignedToId   String?
  assignedTo     User?        @relation("AssignedRM", fields: [assignedToId], references: [id])
  mergedIntoId   String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  completedAt    DateTime?

  activities   Activity[]
  tasks        Task[]
  journeyRuns  JourneyRun[]
  messages     Message[]
  ticketReviews TicketReview[]
  cxConversations Conversation[]
  documents    Document[]
  stageHistory StageHistory[]
  exceptions   Exception[]

  @@index([organizationId])
  @@index([assignedToId])
  @@index([status])
  @@index([currentStageId])
  @@index([assignedToId, status])
  @@index([assignedToId, currentStageId])
  @@index([currentStageId, createdAt])
  @@index([status, createdAt])
  @@index([assignedToId, createdAt])

  @@unique([organizationId, clientCode])
}

model Stage {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  sequence       Int
  slaHours       Int
  isActive       Boolean      @default(true)
  // Reaching this stage automatically marks the client COMPLETED — replaces the
  // old hardcoded KYC+funding+dealer-intro completion check with an org-configurable rule.
  isTerminal     Boolean      @default(false)

  clients          Client[]
  stageHistoryTo   StageHistory[] @relation("ToStage")
  stageHistoryFrom StageHistory[] @relation("FromStage")
  exceptions       Exception[]

  @@unique([organizationId, name])
  @@unique([organizationId, sequence])
}

enum CustomFieldType {
  TEXT
  NUMBER
  DATE
  BOOLEAN
  SELECT
}

// Per-org configurable extra fields for Client, so the CRM isn't hardcoded to
// any one vertical's data model. Values live in Client.customFields, keyed by `key`.
model CustomFieldDefinition {
  id             String          @id @default(cuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  key            String // stable identifier used as the JSON key in Client.customFields
  label          String
  fieldType      CustomFieldType @default(TEXT)
  options        Json? // string[] choices, only for SELECT
  required       Boolean         @default(false)
  sortOrder      Int             @default(0)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([organizationId, key])
  @@index([organizationId, sortOrder])
}

// Org deletion: relations marked onDelete: NoAction are also DEFERRABLE
// INITIALLY DEFERRED in the database (set in migration
// 20261021000000_fix_organization_deletion_cascades — Prisma can't express it).
// Re-apply it if a migration ever recreates one of those foreign keys;
// tests/security/delete-organization.test.ts catches it if you don't.
model StageHistory {
  id          String   @id @default(cuid())
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  fromStageId String?
  fromStage   Stage?   @relation("FromStage", fields: [fromStageId], references: [id])
  toStageId   String
  toStage     Stage    @relation("ToStage", fields: [toStageId], references: [id], onDelete: NoAction)
  changedById String
  changedBy   User     @relation(fields: [changedById], references: [id], onDelete: NoAction)
  changedAt   DateTime @default(now())
  reason      String?
}

enum DocumentStatus {
  PENDING
  RECEIVED
  VERIFIED
  REJECTED
  NOT_APPLICABLE
}

model Document {
  id              String         @id @default(cuid())
  organizationId  String
  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clientId        String
  client          Client         @relation(fields: [clientId], references: [id], onDelete: NoAction)
  documentType    String
  mandatory       Boolean        @default(true)
  status          DocumentStatus @default(PENDING)
  receivedAt      DateTime?
  verifiedAt      DateTime?
  rejectionReason String?
  remarks         String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([organizationId])
}

enum ExceptionStatus {
  OPEN
  RESOLVED
}

model Exception {
  id                 String          @id @default(cuid())
  organizationId     String
  organization       Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clientId           String
  client             Client          @relation(fields: [clientId], references: [id], onDelete: NoAction)
  stageId            String
  stage              Stage           @relation(fields: [stageId], references: [id], onDelete: NoAction)
  reason             String
  notes              String?
  expectedResumeDate DateTime?
  status             ExceptionStatus @default(OPEN)
  createdAt          DateTime        @default(now())
  resolvedAt         DateTime?

  @@index([organizationId])
}

model AuditLog {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // Null for system events (Stripe, cron) and failed sign-ins with an unknown email.
  userId         String?
  user           User?        @relation(fields: [userId], references: [id])
  actorEmail     String? // who acted (or tried to), kept even if the user is later removed
  ipAddress      String?
  userAgent      String?
  entity         String // "Client" | "Document" | "KycRecord" | "FundingRecord" | "DealerIntroduction" | "Exception" | "TicketReview" | "SopDocument" | "ZendeskConnection"
  entityId       String
  action         String // "stage_changed" | "stage_corrected" | "document_verified" | "hold_started" | "reopened" | ...
  oldValue       Json?
  newValue       Json?
  reason         String?
  timestamp      DateTime     @default(now())

  @@index([organizationId, timestamp])
  @@index([entity, entityId])
  @@index([organizationId, action])
}

// ---------------------------------------------------------------------------
// Tasks & unified Activity timeline
// ---------------------------------------------------------------------------

enum TaskStatus {
  PENDING
  DONE
  OVERDUE
  CANCELLED
}

model Task {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clientId       String
  client         Client       @relation(fields: [clientId], references: [id], onDelete: NoAction)

  assignedToId String
  assignedTo   User   @relation(fields: [assignedToId], references: [id], onDelete: NoAction)

  title      String
  dueAt      DateTime
  status     TaskStatus @default(PENDING)
  slaMinutes Int?
  source     String? // "manual" | "journey:<journeyRunId>" | "stage-engine"
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([organizationId])
  @@index([assignedToId, status])
  @@index([dueAt, status])
}

enum ActivityType {
  NOTE
  STATUS_CHANGE
  STAGE_CHANGE
  CALL
  TICKET
  MESSAGE
  TASK_COMPLETED
  JOURNEY_EVENT
}

model Activity {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clientId       String
  client         Client       @relation(fields: [clientId], references: [id], onDelete: NoAction)

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  type      ActivityType
  payload   Json
  createdAt DateTime     @default(now())

  @@index([organizationId])
  @@index([clientId, createdAt])
}

// ---------------------------------------------------------------------------
// Journeys: visual builder graph + runtime state machine
// ---------------------------------------------------------------------------

model Journey {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  isActive       Boolean      @default(false)
  version        Int          @default(1)
  definition     Json // React Flow graph: { nodes: [...], edges: [...] }
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id], onDelete: NoAction)

  runs JourneyRun[]

  @@index([organizationId])
}

enum JourneyRunStatus {
  RUNNING
  WAITING
  COMPLETED
  FAILED
  CANCELLED
}

model JourneyRun {
  id             String           @id @default(cuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  journeyId      String
  journey        Journey          @relation(fields: [journeyId], references: [id], onDelete: NoAction)
  clientId       String
  client         Client           @relation(fields: [clientId], references: [id], onDelete: NoAction)
  currentNodeId  String?
  status         JourneyRunStatus @default(RUNNING)
  context        Json             @default("{}")
  startedAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  steps JourneyRunStep[]

  @@index([organizationId])
  @@index([journeyId, clientId])
  @@index([status])
}

model JourneyRunStep {
  id           String     @id @default(cuid())
  runId        String
  run          JourneyRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  nodeId       String
  nodeType     String // "trigger" | "action" | "condition" | "wait"
  status       String // "pending" | "success" | "failed" | "skipped"
  result       Json?
  scheduledFor DateTime?
  executedAt   DateTime?
  createdAt    DateTime   @default(now())

  @@index([status, scheduledFor])
}

// ---------------------------------------------------------------------------
// Integrations (pluggable connector framework)
// ---------------------------------------------------------------------------

model IntegrationConfig {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  provider       String // "clevertap" | "exotel" | "freshdesk" | "whatsapp_meta" | "sms_exotel" | ...
  mode           String       @default("mock") // "mock" | "live"
  credentials    Json? // encrypted JSON blob (AES-256-GCM) — see src/lib/security/crypto.ts
  settings       Json?
  isEnabled      Boolean      @default(false)
  updatedAt      DateTime     @updatedAt
  // Opaque per-org-per-provider token embedded in this org's inbound webhook URL
  // (see src/app/api/webhooks/[provider]/[token]/route.ts) so the URL itself
  // identifies the tenant — inbound webhooks never have to guess/fall back to
  // an arbitrary org's config.
  webhookToken   String       @unique @default(cuid())

  @@unique([organizationId, provider])
}

// ---------------------------------------------------------------------------
// Messaging (WhatsApp / SMS)
// ---------------------------------------------------------------------------

model MessageTemplate {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  channel        String // "whatsapp" | "sms"
  provider       String // "meta_cloud" | "gupshup" | "exotel" | ...
  name           String
  externalId     String? // provider-registered template id/name
  body           String
  variables      Json?
  approved       Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  messages Message[]

  @@index([organizationId])
}

enum MessageDirection {
  OUTBOUND
  INBOUND
}

enum MessageStatus {
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
}

model Message {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clientId       String
  client         Client       @relation(fields: [clientId], references: [id], onDelete: NoAction)

  channel    String
  provider   String
  direction  MessageDirection
  templateId String?
  template   MessageTemplate? @relation(fields: [templateId], references: [id])
  body       String
  status     MessageStatus    @default(QUEUED)
  externalId String?
  metadata   Json?
  // Inbound only: when someone opened the conversation in the Inbox (null = unread).
  readAt     DateTime?
  createdAt  DateTime         @default(now())

  @@index([organizationId])
  @@index([clientId, createdAt])
  @@index([organizationId, direction, readAt])
}

// ---------------------------------------------------------------------------
// Notifications
// ---------------------------------------------------------------------------

model Notification {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: NoAction)
  type           String // "stage_sla_breach" | "document_rejected" | "kyc_update" | "funding_pending" | "dealer_intro_pending" | "new_assignment" | "hold_started" | "client_reopened" | "task_overdue" | "task_overdue_escalation" | "inbound_message" | ...
  payload        Json
  readAt         DateTime?
  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@index([userId, readAt])
}

// ---------------------------------------------------------------------------
// Supportify platform: QA product (v1, ported from the standalone QA_Tool
// prototype — Python/FastAPI + SQLite/Turso, see qa-tool-reference/app in the
// sibling clone — onto this app's Postgres/Prisma stack, scoped per
// Organization instead of QA_Tool's single shared DB).
// ---------------------------------------------------------------------------

// The helpdesk QA Sentinel reads tickets from (one per organization). `provider`
// picks the adapter in src/lib/qa/helpdesks; credentials are provider-specific JSON.
model HelpdeskConnection {
  id                   String       @id @default(cuid())
  organizationId       String       @unique
  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  provider             String       @default("zendesk") // HelpdeskProviderId, e.g. "zendesk" | "freshdesk" | "intercom"
  accountLabel         String // non-secret display name, e.g. "acme.zendesk.com"
  encryptedCredentials String // AES-256-GCM via src/lib/security/crypto.ts
  isValid              Boolean      @default(false)
  lastCheckedAt        DateTime?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
}

model SopDocument {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  category       String       @default("general")
  content        String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  primaryForReviews TicketReview[] @relation("PrimarySop")

  @@unique([organizationId, name])
  @@index([organizationId, category])
}

model TicketReview {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  ticketId      String
  ticketSubject String?
  agentName     String?
  agentEmail    String?

  // qa_reviews originally supported grading against multiple SOPs at once
  // (sop_ids/sop_names) in addition to a single primary sop_id/sop_name.
  primarySopId String?
  primarySop   SopDocument? @relation("PrimarySop", fields: [primarySopId], references: [id])
  sopIds       Json?
  sopNames     Json?

  overallScore        Int?
  criteriaScores      Json?
  sentiment           String?
  summary             String?
  strengths           Json?
  improvements        Json?
  sopViolations       Json?
  excludedCriteria    Json?
  dismissedViolations Json?
  accuracyDetail      Json?

  rawConversation String? // full ticket transcript snapshot at review time

  auditorComment   String?
  auditorUpdatedAt DateTime?
  scoreEditedAt    DateTime?

  tokensInput   Int?
  tokensOutput  Int?
  tokensCostUsd Decimal?

  // Scorecard used (null = built-in default) and a snapshot of its criteria at review
  // time, so editing a scorecard never changes past reviews.
  scorecardId       String?
  scorecardSnapshot Json?
  autoFailed        Boolean @default(false)
  autoFailReasons   Json? // labels of criteria that triggered auto-fail

  source    String  @default("manual") // "manual" | "bulk" | "auto"
  helpdesk  String  @default("zendesk") // provider the ticket came from (ticket ids are only unique per helpdesk)
  isOverage Boolean @default(false) // billed as a usage-based overage review

  // The customer who raised the ticket (when the helpdesk exposes them) and the CRM client
  // they were matched to — see src/lib/support-health/link.ts. Email lowercased, phone digits only.
  requesterName  String?
  requesterEmail String?
  requesterPhone String?
  clientId       String?
  client         Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  clientLinkedBy String? // "auto" (exact email/phone match) | "manual" (an admin linked it)

  createdAt DateTime @default(now())

  calibrationSessions CalibrationSession[]
  coachingSessions    CoachingSession[]
  disputes            ReviewDispute[]

  @@index([organizationId, createdAt])
  @@index([organizationId, ticketId])
  @@index([organizationId, agentEmail])
  @@index([organizationId, clientId, createdAt])
  @@index([organizationId, requesterEmail])
  @@index([organizationId, requesterPhone])
}

// An admin's decision about one helpdesk requester (by email or phone): their tickets belong to
// this client, or (clientId null) to no client, overriding automatic matching.
model RequesterLink {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  kind           String // "email" | "phone"
  value          String // normalised: lowercased email, or phone digits
  clientId       String?
  createdById    String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, kind, value])
}

// ---------------------------------------------------------------------------
// QA calibration: multiple human reviewers independently score the same
// ticket (blind to each other's scores until they submit, or until the
// session is closed) to check how consistently the team applies the SOP —
// the AI's own review is shown as one more entry, not a privileged baseline.
// ---------------------------------------------------------------------------

enum CalibrationStatus {
  OPEN
  CLOSED
}

model CalibrationSession {
  id             String            @id @default(cuid())
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  reviewId       String
  review         TicketReview      @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  createdById    String
  createdBy      User              @relation(fields: [createdById], references: [id], onDelete: NoAction)
  status         CalibrationStatus @default(OPEN)
  createdAt      DateTime          @default(now())
  closedAt       DateTime?

  entries CalibrationEntry[]

  @@index([organizationId, createdAt])
}

model CalibrationEntry {
  id             String             @id @default(cuid())
  sessionId      String
  session        CalibrationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  reviewerId     String
  reviewer       User               @relation(fields: [reviewerId], references: [id], onDelete: NoAction)
  overallScore   Int?
  criteriaScores Json?
  notes          String?
  submittedAt    DateTime?
  createdAt      DateTime           @default(now())

  @@unique([sessionId, reviewerId])
}

model DsatAnalysis {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  ticketId        String?
  ticketSubject   String?
  customerName    String?
  agentName       String?
  context         String?
  rawConversation String?

  whatWentWrong               String?
  rootCauses                  Json?
  customerImpact              String?
  csatRecoveryRecommendations Json?
  followUpResponse            Json?
  preventionTips              Json?
  recoveryProbability         String?
  recoveryRationale           String?
  improvementsComment         String?

  createdAt DateTime @default(now())

  @@index([organizationId, ticketId])
  @@index([organizationId, createdAt])
}

// ---------------------------------------------------------------------------
// QA auto-review: periodically pull newly solved Zendesk tickets, sample them by
// the org's rules, queue them, and score them in the background.
// ---------------------------------------------------------------------------

model AutoReviewConfig {
  id                  String       @id @default(cuid())
  organizationId      String       @unique
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  enabled             Boolean      @default(false)
  sopId               String? // rubric used for auto reviews
  scorecardId         String? // null = the org's default scorecard
  samplePercent       Int          @default(20) // % of solved tickets reviewed at random (deterministic per ticket)
  alwaysReviewBadCsat Boolean      @default(true) // always review tickets rated "bad" by the customer
  includeTags         String[] // only tickets with at least one of these tags (empty = all)
  excludeTags         String[] // never tickets with any of these tags
  lastPolledAt        DateTime?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
}

enum AutoReviewJobStatus {
  QUEUED
  PROCESSING
  DONE
  SKIPPED
  FAILED
}

model AutoReviewJob {
  id             String              @id @default(cuid())
  organizationId String
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ticketId       String
  helpdesk       String              @default("zendesk")
  reason         String // why it was picked: "sample" | "bad_csat"
  status         AutoReviewJobStatus @default(QUEUED)
  attempts       Int                 @default(0)
  lastError      String?
  reviewId       String?
  createdAt      DateTime            @default(now())
  startedAt      DateTime?
  processedAt    DateTime?

  @@unique([organizationId, helpdesk, ticketId])
  @@index([status, createdAt])
}

// Fixed-window rate-limit counters (login, signup, password reset, public API).
// Kept in Postgres so limits hold across serverless instances without another service.
model RateLimitBucket {
  key     String   @id // e.g. "login:ip:1.2.3.4", "login:email:<sha256>"
  count   Int
  resetAt DateTime

  @@index([resetAt])
}

// Custom QA scorecards (Growth and above). criteria is an array of
// { key, label, description, weight, autoFailBelow } — see src/lib/qa/scorecard.ts.
model Scorecard {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  isDefault      Boolean      @default(false)
  criteria       Json
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
}

// ---------------------------------------------------------------------------
// QA coaching: a coach assigns an agent (identified by helpdesk email, since
// agents needn't have a Supportify login) a session to work on specific
// criteria, usually from a low-scoring review.
// ---------------------------------------------------------------------------

enum CoachingStatus {
  ASSIGNED
  ACKNOWLEDGED
  COMPLETED
  CANCELLED
}

model CoachingSession {
  id             String         @id @default(cuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  agentEmail     String
  agentName      String?
  reviewId       String?
  review         TicketReview?  @relation(fields: [reviewId], references: [id], onDelete: SetNull)
  coachId        String
  coach          User           @relation("CoachingCoach", fields: [coachId], references: [id], onDelete: NoAction)
  focusAreas     Json? // criterion labels to work on
  notes          String
  agentResponse  String? // the agent's reflection, recorded on acknowledgement/completion
  outcome        String? // coach's wrap-up note
  dueDate        DateTime?
  status         CoachingStatus @default(ASSIGNED)
  acknowledgedAt DateTime?
  completedAt    DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([organizationId, status])
  @@index([organizationId, agentEmail])
}

// ---------------------------------------------------------------------------
// QA disputes: an appeal against a review's score (overall or one criterion).
// An owner/admin resolves it by upholding the score or adjusting it; the
// original and adjusted scores are kept for the audit trail.
// ---------------------------------------------------------------------------

enum DisputeStatus {
  OPEN
  UPHELD
  ADJUSTED
}

model ReviewDispute {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  reviewId       String
  review         TicketReview  @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  raisedById     String
  raisedBy       User          @relation("DisputeRaisedBy", fields: [raisedById], references: [id], onDelete: NoAction)
  criterionKey   String? // null = the overall score
  reason         String
  status         DisputeStatus @default(OPEN)
  resolvedById   String?
  resolvedBy     User?         @relation("DisputeResolvedBy", fields: [resolvedById], references: [id])
  resolutionNote String?
  originalScore  Int? // overall score when the dispute was resolved
  adjustedScore  Int? // overall score after an adjustment
  resolvedAt     DateTime?
  createdAt      DateTime      @default(now())

  @@index([organizationId, status])
  @@index([reviewId])
}

// ---------------------------------------------------------------------------
// CX Intelligence (Product.CX_INTELLIGENCE): every customer conversation from every
// source in one table, PII-redacted before it is stored (src/lib/cx/redact.ts), then
// analysed by Claude into topics, sentiment, root cause and risk. Retention is per org
// (CxCostSettings.retentionMonths, default 13).
// ---------------------------------------------------------------------------

enum CxSourceType {
  HELPDESK
  SURVEY
  REVIEW
  CALL
  BOT
}

enum CxAnalysisStatus {
  PENDING // stored, not yet sent for analysis
  QUEUED // in a classification batch
  DONE
  FAILED
  SKIPPED_QUOTA // over the plan's analysis quota this period: stored and counted, not analysed
}

enum TopicStatus {
  PROPOSED // suggested by the model, not yet used for classification
  ACTIVE
  MERGED
  ARCHIVED
}

enum TeamKind {
  OWNER // the team that fixes a topic's root cause (product, logistics, billing…)
  SUPPORT // an in-house support team
  BPO // an outsourced support partner
}

// One connected data source per org and provider. Helpdesk sources reuse the org's
// HelpdeskConnection credentials and only keep their own polling cursor here.
model CxSource {
  id                   String       @id @default(cuid())
  organizationId       String
  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  type                 CxSourceType
  provider             String // "zendesk" | "surveymonkey" | "app_store" | "exotel" | "csv" | ...
  label                String
  encryptedCredentials String? // AES-256-GCM (src/lib/security/crypto.ts); null for helpdesk sources
  webhookToken         String       @unique @default(cuid()) // identifies the org on inbound webhooks
  cursor               String? // provider-specific "seen up to" marker for incremental polling
  backfillFrom         DateTime? // how far back the first import reaches
  status               String       @default("active") // "active" | "paused" | "error"
  lastError            String?
  lastSyncedAt         DateTime?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  conversations Conversation[]
  ingestJobs    CxIngestJob[]

  @@unique([organizationId, provider])
}

enum CxIngestJobStatus {
  QUEUED
  PROCESSING
  DONE
  FAILED
}

// One ticket (or other item) to fetch, redact and store. A ticket seen again after it changed
// (reopened and solved again) is re-queued; its conversation is updated in place.
model CxIngestJob {
  id              String            @id @default(cuid())
  organizationId  String
  sourceId        String
  source          CxSource          @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  externalId      String
  status          CxIngestJobStatus @default(QUEUED)
  attempts        Int               @default(0)
  lastError       String?
  listedUpdatedAt String? // the source's "last updated" value when it was listed
  createdAt       DateTime          @default(now())
  startedAt       DateTime?
  processedAt     DateTime?

  @@unique([sourceId, externalId])
  @@index([status, createdAt])
  @@index([organizationId, status])
}

model Conversation {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sourceId       String?
  source         CxSource?    @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  sourceType     CxSourceType
  provider       String
  externalId     String // the id in the source system (ticket id, survey response id, review id…)
  channel        String? // "email" | "chat" | "voice" | "social" | "survey" | "review" | ...

  startedAt     DateTime
  firstReplyAt  DateTime?
  solvedAt      DateTime?
  handleTimeSec Int?
  replyCount    Int?
  reopenCount   Int?

  // The customer, as a salted hash of their normalised email/phone so repeat contacts can be
  // counted without storing contact details; optionally matched to a CRM client.
  customerKey String?
  clientId    String?
  client      Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  agentEmail String?
  agentName  String?
  isBot      Boolean @default(false)
  teamId     String?
  team       Team?   @relation(fields: [teamId], references: [id], onDelete: SetNull)

  subject          String? // redacted
  turns            Json // [{ role: "customer"|"agent"|"bot", text, at? }], redacted
  textHash         String // of the redacted text: unchanged conversations are never re-analysed
  truncated        Boolean @default(false)
  redactionVersion Int
  rating           Float? // CSAT/NPS/star rating as given by the source
  ratingScale      String? // "csat_5" | "nps_10" | "stars_5" | "good_bad"
  tags             String[]
  language         String?
  metadata         Json?

  analysisStatus CxAnalysisStatus      @default(PENDING)
  classifyBatchId String? // the Message Batch analysing it, while QUEUED
  analysis       ConversationAnalysis?
  topics         ConversationTopic[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, provider, externalId])
  @@index([organizationId, startedAt])
  @@index([organizationId, analysisStatus])
  @@index([organizationId, customerKey])
  @@index([classifyBatchId])
}

model ConversationAnalysis {
  id                String       @id @default(cuid())
  conversationId    String       @unique
  conversation      Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  taxonomyVersionId String?
  summary           String?
  rootCause         String?
  sentiment         Float? // -1 (very negative) … 1 (very positive), whole conversation
  sentimentStart    Float?
  sentimentEnd      Float?
  churnRisk         Float? // 0 … 1
  escalationRisk    Float? // 0 … 1
  predictedCsat     Float? // 1 … 5
  customerEffort    Float? // 1 … 5
  deflectable       Boolean      @default(false) // could have been answered by self-service/automation
  deflectableReason String?
  qualityScore      Float? // 0 … 100, lightweight
  qualityFlags      String[]
  proposedTopic     String? // when no existing topic fit: the model's suggestion for a new one
  model             String
  promptVersion     String
  costUsd           Float
  createdAt         DateTime     @default(now())
}

// A two-level taxonomy: themes (parentId null) and the topics under them.
model Topic {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  key            String // stable slug used in classification output, unique per org
  name           String
  description    String?
  parentId       String?
  parent         Topic?       @relation("TopicHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children       Topic[]      @relation("TopicHierarchy")
  status         TopicStatus  @default(ACTIVE)
  mergedIntoId   String?
  origin         String       @default("discovered") // "discovered" | "manual" | "proposed"
  ownerTeamId    String?
  ownerTeam      Team?        @relation(fields: [ownerTeamId], references: [id], onDelete: SetNull)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  conversations ConversationTopic[]
  issues        TopicIssue[]

  @@unique([organizationId, key])
  @@index([organizationId, status])
}

// Conversation ↔ topic, with copies of org/date/channel so topic aggregates need no join.
model ConversationTopic {
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  topicId        String
  topic          Topic        @relation(fields: [topicId], references: [id], onDelete: Cascade)
  organizationId String
  startedAt      DateTime
  channel        String?
  isPrimary      Boolean      @default(false)
  confidence     Float?
  evidence       String? // a short redacted quote supporting the classification

  @@id([conversationId, topicId])
  @@index([organizationId, topicId, startedAt])
}

// The topic list as it was when conversations were classified against it.
model TaxonomyVersion {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  version        Int
  status         String       @default("active") // "discovering" | "merging" | "active" | "failed" (src/lib/cx/ai/discover.ts)
  snapshot       Json // active: [{ key, name, description, parentKey }]; while discovering: { candidates }
  costUsd        Float        @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @default(now()) @updatedAt

  @@unique([organizationId, version])
}

model Team {
  id               String       @id @default(cuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name             String
  kind             TeamKind
  // BPO teams are benchmarked against this in-house team.
  benchmarkTeamId  String?
  benchmarkTeam    Team?        @relation("TeamBenchmark", fields: [benchmarkTeamId], references: [id], onDelete: SetNull)
  benchmarkedBy    Team[]       @relation("TeamBenchmark")
  createdAt        DateTime     @default(now())

  agentMappings AgentTeamMapping[]
  conversations Conversation[]
  ownedTopics   Topic[]
  topicIssues   TopicIssue[]

  @@unique([organizationId, name])
}

// How support agents map to teams: an exact agent email, a whole email domain (typical
// for a BPO), or a helpdesk group name.
model AgentTeamMapping {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  teamId         String
  team           Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  matchType      String // "email" | "domain" | "group"
  value          String // lowercased
  createdAt      DateTime     @default(now())

  @@unique([organizationId, matchType, value])
}

// The money inputs behind CX $ impact, and how long conversation data is kept.
model CxCostSettings {
  id                  String       @id @default(cuid())
  organizationId      String       @unique
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  currency            String       @default("USD")
  costPerContact      Json         @default("{}") // { email: 4.5, chat: 3, voice: 7, default: 4 }
  agentHourlyCost     Float?
  averageOrderValue   Float?
  customerLifetimeVal Float?
  churnPropensity     Float? // 0 … 1: share of high-risk customers expected to leave
  deflectionRate      Float? // 0 … 1: share of deflectable contacts automation could absorb
  retentionMonths     Int          @default(13)
  updatedAt           DateTime     @updatedAt
}

// One Anthropic Message Batch of conversations sent for analysis (half price, results within
// hours). Collected by the CX worker once Anthropic reports it ended.
model CxClassifyBatch {
  id                String       @id @default(cuid())
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  anthropicBatchId  String       @unique
  taxonomyVersionId String
  status            String       @default("in_progress") // "in_progress" | "collected"
  requestCount      Int
  succeeded         Int          @default(0)
  failed            Int          @default(0)
  costUsd           Float        @default(0)
  createdAt         DateTime     @default(now())
  collectedAt       DateTime?

  @@index([status, createdAt])
}

// Daily totals per org and dimension (everything, a topic, channel, source or team), rebuilt
// for a day whenever analyses for it land. Dashboards and early warnings read these.
model CxMetricBucket {
  organizationId     String
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  day                DateTime     @db.Date
  dimension          String // "all" | "topic" | "channel" | "source" | "team"
  dimensionId        String       @default("")
  conversations      Int
  sentimentSum       Float        @default(0)
  sentimentCount     Int          @default(0)
  negativeCount      Int          @default(0)
  ratingSum          Float        @default(0) // real CSAT where the source has it, on a 1-5 scale
  ratingCount        Int          @default(0)
  predictedCsatSum   Float        @default(0)
  predictedCsatCount Int          @default(0)
  highRiskCount      Int          @default(0)
  deflectableCount   Int          @default(0)
  handleTimeSum      Int          @default(0)
  handleTimeCount    Int          @default(0)

  @@id([organizationId, day, dimension, dimensionId])
}

enum TopicIssueStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

// A problem behind a topic, owned by the team that fixes it and tracked until resolved
// (e.g. "Courier X missing delivery slots" under Late delivery).
model TopicIssue {
  id             String           @id @default(cuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  topicId        String
  topic          Topic            @relation(fields: [topicId], references: [id], onDelete: Cascade)
  title          String
  note           String?
  status         TopicIssueStatus @default(OPEN)
  ownerTeamId    String?
  ownerTeam      Team?            @relation(fields: [ownerTeamId], references: [id], onDelete: SetNull)
  createdById    String
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  resolvedAt     DateTime?

  @@index([organizationId, status])
  @@index([topicId])
}
